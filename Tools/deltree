#!/usr/bin/env zsh
set -euo pipefail

json=false
dry_run=false
command="inventory"
redact=false

usage() {
  cat <<'EOF'
deltree - local Codex/Xcode storage inventory helper

Usage:
  deltree [--json] [--dry-run] [--redact]
  deltree diagnose [--json] [--raw-paths]

Options:
  --json       Print JSON instead of text.
  --dry-run    Show cleanup candidates without modifying anything.
  --redact     Redact paths and identifiers in inventory output.
  --raw-paths  Keep raw paths in diagnose output.

This CLI scans bounded developer paths only. It never deletes files.
Diagnostic output is redacted by default for issue reports.
EOF
}

json_string() {
  local value="$1"
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}
  value=${value//$'\r'/\\r}
  value=${value//$'\t'/\\t}
  printf '"%s"' "$value"
}

redact_value() {
  local value="$1"
  value="${value//$HOME/~}"
  value="${value//\/Users\/$USER/~}"
  value="${value//$USER/<user>}"
  value="$(printf '%s' "$value" | sed -E \
    -e 's#[A-Z0-9._%+-]+@[A-Z0-9.-]+\.[A-Z]{2,}#<email>#Ig' \
    -e 's#\b[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}\b#<uuid>#g' \
    -e 's#\b((task|session|thread|conversation)-)[A-Za-z0-9_-]{6,}\b#\1<codex-session>#g' \
    -e 's#([A-Za-z0-9_. -]+)-[A-Za-z0-9]{16,}(/|$)#\1-<derived-data-id>\2#g' \
    -e 's#/(private/)?var/folders/[^[:space:]"'\'']+#<temp>#g')"
  printf '%s' "$value"
}

display_value() {
  local value="$1"
  if [[ "$redact" == true ]]; then
    redact_value "$value"
  else
    printf '%s' "$value"
  fi
}

repeat_char() {
  local char="$1"
  local count="$2"
  local output=""
  local index
  for (( index = 0; index < count; index++ )); do
    output+="$char"
  done
  printf '%s' "$output"
}

block_meter() {
  local size_kb="$1"
  local width=10
  local percent=0
  local filled=0
  if (( total_kb > 0 )); then
    percent=$(( (size_kb * 100 + total_kb / 2) / total_kb ))
    filled=$(( (size_kb * width + total_kb / 2) / total_kb ))
  fi
  if (( filled > width )); then
    filled=$width
  fi
  local empty=$(( width - filled ))
  printf '%s%s %3d%%' "$(repeat_char '█' "$filled")" "$(repeat_char '░' "$empty")" "$percent"
}

if [[ "${1:-}" == "diagnose" ]]; then
  command="diagnose"
  redact=true
  dry_run=true
  shift
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --json) json=true ;;
    --dry-run) dry_run=true ;;
    --redact) redact=true ;;
    --raw-paths) redact=false ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown option: $1" >&2; usage; exit 2 ;;
  esac
  shift
done

roots=(
  "$HOME/.codex"
  "$HOME/Documents/Codex"
  "$HOME/Library/Developer/CoreSimulator/Devices"
  "$HOME/Library/Developer/XCTestDevices"
  "$HOME/Library/Developer/Xcode/DerivedData"
  "$HOME/Library/Developer/Xcode/Products"
  "$HOME/Library/Developer/Xcode/iOS DeviceSupport"
  "$HOME/Library/Developer/CoreSimulator/Caches"
  "$HOME/Library/Developer/CoreSimulator/Profiles/Runtimes"
  "/Library/Developer/CoreSimulator/Profiles/Runtimes"
  "/Library/Developer/CoreSimulator/Images"
  "$HOME/Library/Developer/CoreSimulator/Images"
  "$HOME/Library/Developer/Xcode/Archives"
  "$HOME/Library/Caches/org.swift.swiftpm"
  "$HOME/Library/org.swift.swiftpm"
  "$HOME/.swiftpm"
)

items=()
total_kb=0
for root in "${roots[@]}"; do
  [[ -e "$root" ]] || continue
  size_kb=$(du -sk "$root" 2>/dev/null | awk '{print $1}' || true)
  [[ -n "${size_kb:-}" ]] || continue
  total_kb=$((total_kb + size_kb))
  items+=("${size_kb}|${root}")
done

if [[ "$json" == true ]]; then
  printf '{"command":%s,"dryRun":%s,"redacted":%s,"totalBytes":%d' "$(json_string "$command")" "$dry_run" "$redact" "$((total_kb * 1024))"
  if [[ "$command" == "diagnose" ]]; then
    printf ',"home":%s,"user":%s' "$(json_string "$(display_value "$HOME")")" "$(json_string "$(display_value "$USER")")"
  fi
  printf ',"items":['
  first=true
  for entry in "${items[@]}"; do
    size="${entry%%|*}"
    item_path="${entry#*|}"
    if [[ "$first" == false ]]; then printf ','; fi
    first=false
    printf '{"path":%s,"bytes":%d}' "$(json_string "$(display_value "$item_path")")" "$((size * 1024))"
  done
  printf ']}\n'
else
  local_title="STORAGE INVENTORY"
  if [[ "$command" == "diagnose" ]]; then
    local_title="DIAGNOSTICS"
  fi
  echo "DELTREE CLASSIC :: $local_title"
  echo "--------------------------------"
  echo "MODE    $command"
  echo "SAFETY  [SAFE] read-only scan; no files modified."
  echo "TOTAL   $((total_kb / 1024)) MB"
  if [[ "$command" == "diagnose" ]]; then
    echo "REDACT  $redact"
    echo "HOME    $(display_value "$HOME")"
  fi
  if [[ "$dry_run" == true ]]; then
    echo "DRYRUN  true"
  fi
  echo "--------------------------------"
  printf '%s\n' "${items[@]}" | sort -nr | while IFS='|' read -r size item_path; do
    [[ -n "${size:-}" ]] || continue
    printf "%8d MB  %s  [REVIEW]  %s\n" "$((size / 1024))" "$(block_meter "$size")" "$(display_value "$item_path")"
  done
fi
